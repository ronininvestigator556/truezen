{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrueZen",
  "version": "0.1.0",
  "identifier": "com.truezen.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TrueZen",
        "width": 1280,
        "height": 860,
        "minWidth": 940,
        "minHeight": 620,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Alex Allen",
    "copyright": "Copyright (c) 2026 Alex Allen",
    "category": "Music",
    "shortDescription": "Brainwave entrainment studio",
    "longDescription": "Generates binaural beats, isochronic tones, monaural beats and multi-layer stacks for meditation, focus and sleep. Dial in an exact carrier and beat frequency, or start from a preset.",
    "licenseFile": "../LICENSE",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2",
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
